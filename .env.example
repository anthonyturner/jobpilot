# Optional. You can enter everything below in the app instead (setup wizard or
# Settings > API keys). Values here override the app. Copy to .env to use.
# .env is git-ignored. Never commit real keys.

# --- Server ---------------------------------------------------------------
# PORT=7317
# TIMEZONE=America/New_York
# LOG_LEVEL=info
# Sent in the User-Agent to job APIs (USAJOBS requires it).
CONTACT_EMAIL=

# Token for POST /api/ingest. Leave blank to auto-generate one in data/ingest-token.
INGEST_TOKEN=

# --- Indeed (official connector via headless Claude Code) -------------------
# true = each sweep runs `claude -p` on Haiku with ONLY the Indeed search tool
# allowed (about $0.07 per query). Needs Claude Code logged in with the Indeed
# connector enabled on claude.ai.
INDEED_VIA_CLAUDE=false
# CLAUDE_BIN=claude

# --- Keyed job APIs (all have free tiers) -----------------------------------
# https://developer.adzuna.com  (US aggregator, 250 calls/day free)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# https://developer.usajobs.gov  (federal jobs; also set CONTACT_EMAIL)
USAJOBS_API_KEY=

# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Google for Jobs data: LinkedIn, Glassdoor, ZipRecruiter and more. Small free tier.
JSEARCH_API_KEY=

# --- Phase 2: assisted applying ------------------------------------------------
# Your base resume (.docx). Imported on first start; re-import from Settings.
RESUME_PATH=
# Chrome or Edge is found automatically; set this only if detection fails.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Model and per-packet spend cap for tailoring (headless Claude Code, no tools).
# TAILOR_MODEL=sonnet
# TAILOR_MAX_BUDGET_USD=1.00
